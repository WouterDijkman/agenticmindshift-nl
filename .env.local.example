# ── Report generation (DeepSeek, OpenAI-compatible) ──────────────────────────
# API key for the inference host. Required to generate reports.
DEEPSEEK_API_KEY=
# Optional thematic web-search enrichment (graceful if absent).
SERPER_API_KEY=
#
# Inference host. Defaults to the FIRST-PARTY DeepSeek API, which stores inputs
# in China and may train on them — NOT zero-data-retention. For ZDR, point these
# at a Western host that runs the DeepSeek weights under a no-retention policy.
#
#   First-party (default, NOT ZDR):
#     DEEPSEEK_BASE_URL=https://api.deepseek.com
#     DEEPSEEK_MODEL=deepseek-chat
#
#   Fireworks AI (US/EU-hosted, zero data retention by default — recommended):
#     DEEPSEEK_BASE_URL=https://api.fireworks.ai/inference/v1
#     DEEPSEEK_MODEL=accounts/fireworks/models/deepseek-v3
#     DEEPSEEK_API_KEY=<your Fireworks key>
#
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
