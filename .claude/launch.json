{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "factum",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "factumcapital", "exec", "next", "dev", "-p", "3100"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "agenticmindshift-nl", "exec", "next", "dev", "-p", "3000"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
