{
  "name": "agenticmindshift-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:web": "pnpm --filter agenticmindshift-nl dev",
    "dev:factum": "pnpm --filter factumcapital dev",
    "build:web": "pnpm --filter agenticmindshift-nl build",
    "build:factum": "pnpm --filter factumcapital build",
    "build": "pnpm -r build"
  }
}
